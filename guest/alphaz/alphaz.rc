// SPDX-License-Identifier: GPL-2.0-or-later
// alphaz.rc: ALPHAZ.EXE's icon and version. build.sh copies this script
// next to the icon mkicon.py writes, and nada compiles both into .rsrc.
// Copyright (C) 2026 Artur Goulão

#include <windows.h>

1 ICON "alphaz.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "AlphaZ"
            VALUE "FileDescription", "AlphaZ: the processors and machine an Alpha guest of Alphabox reports"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Artur Goul\343o, GPL-2.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
