# An ES40 with most of what the generator offers.
platform = es40
gui = SDL
gui.scale = yes
gui.scale_ratio = 2
memory = 1G
cpus = 2
cpu.skip_memtest = yes
serial0.program = xterm
serial0.args = -e telnet localhost 21264
floppy.disk = 0
floppy.path = floppy.img
floppy.create = no
floppy.disk = none
ide.disk = 1.0
ide.type =
ide.cdrom = cd-rom
ide.path = ALPHA084.ISO
ide.model = CD "W" 216
ide.disk = none
vga = cirrus
vga.chip = gd5430
vga.slot = pci0.2
vga.rom = pci.bin
card = scsi
scsi.model = sym53c875
scsi.disk = 0
scsi.path = dka0.img
scsi.size = 4G
scsi.disk = 5
scsi.type = file
scsi.type = ramdisk
scsi.path = none
scsi.size = 10M
scsi.disk = none
card = nic
nic.type = udp
nic.udp_local = 127.0.0.1:21511
card = ide
ide.disk = 0.0
ide.type = ramdisk
ide.path = boot.img
ide.disk = none
card = audio
card = none
console = serial
lpt = lpt.out
arc_year = nt
time = yes
time.value = 2001-2-3 4:5:6
exit_on_halt = yes
