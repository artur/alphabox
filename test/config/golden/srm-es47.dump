# exit 0
sys0 = tsunami
{
  platform = "es47";
  memory.bits = "26";
  rom.srm = "cl67srmrom.exe";
  rom.decompressed = "decompressed.rom";
  rom.flash = "flash.rom";
  rom.dpr = "dpr.rom";
  cpu0 = ev7
  {
    speed = "800M";
  }
  serial0 = serial
  {
    address = "127.0.0.1";
    port = "21000";
  }
  pci2.2 = cmd649
  {
  }
  pci2.3 = uss344
  {
    port1 = "tablet";
    port2 = "keyboard";
  }
  fdc0 = floppy // added
  {
  }
  serial1 = serial // added
  {
    null_attach = "true";
  }
}
