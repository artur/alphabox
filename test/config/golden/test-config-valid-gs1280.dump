# exit 0
sys0 = tsunami
{
  platform = "gs1280";
  memory.bits = "29";
  rom.srm = "SRM_V7_3.EXE";
  rom.decompressed = "SRM_V7_3.EXE-decompressed.rom";
  cpu0 = ev7
  {
    speed = "1000M";
  }
  cpu1 = ev7
  {
    speed = "1000M";
  }
  pci2.1 = sym53c895
  {
    disk0.0 = file
    {
      file = "disk.img";
    }
  }
  pci0.1 = dec21143
  {
    type = "null";
  }
  pci2.2 = cmd649
  {
    disk0.0 = file
    {
      file = "ALPHA084.ISO";
      read_only = "true";
      cdrom = "true";
      model_number = "CD-W216E";
    }
  }
  pci2.3 = uss344
  {
    port1 = "tablet";
    port2 = "keyboard";
  }
  serial0 = serial
  {
    port = "21814";
  }
  fdc0 = floppy // added
  {
  }
  serial1 = serial // added
  {
    null_attach = "true";
  }
}
