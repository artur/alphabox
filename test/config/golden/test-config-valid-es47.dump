# exit 0
gui = sdl
{
  keyboard.use_mapping = "false";
}

sys0 = tsunami
{
  platform = "es47";
  memory.bits = "30";
  rom.srm = "SRM_V7_3.EXE";
  rom.decompressed = "SRM_V7_3.EXE-decompressed.rom";
  rom.nvram = "cmm_nvram.bin";
  cpu0 = ev7z
  {
    speed = "1300M";
  }
  cpu1 = ev7z
  {
    speed = "1300M";
  }
  pci0.1 = dec21143
  {
    type = "null";
  }
  pci0.2 = de602
  {
    pci.1 = de602_port
    {
      type = "udp";
      udp_local = "127.0.0.1:21511";
      udp_remote = "127.0.0.1:21512";
    }
    pci.0 = de602_port // added
    {
      type = "null";
    }
  }
  pci2.1 = sym53c895
  {
    disk0.0 = ramdisk
    {
      size = "64M";
    }
    disk0.1 = file
    {
      file = "disk.img";
    }
  }
  pci2.2 = cmd649
  {
    disk0.0 = file
    {
      file = "ALPHA084.ISO";
      read_only = "true";
      cdrom = "true";
      model_number = "CD-W216E";
    }
  }
  pci2.3 = uss344
  {
    port1 = "tablet";
    port2 = "keyboard";
  }
  pci3.5 = radeon
  {
    rom = "radeon7500.rom";
  }
  serial0 = serial
  {
    port = "21771";
  }
  fdc0 = floppy // added
  {
  }
  serial1 = serial // added
  {
    null_attach = "true";
  }
}
