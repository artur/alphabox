+const char *intname(int s) {
+  static const char *n[] = {"IPI",        "interval timer", "PCI device",
+                            "PIC (ISA)",  "PIC dismissed",  "ext dismissed",
+                            "software",   "AST",            "none"};
+  return s >= 0 && s < 9 ? n[s] : "?";
