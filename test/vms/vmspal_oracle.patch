+  std::vector<std::pair<int, STBEntry>> sh_log;
+  bool sh_all = false;
+  std::vector<STBEntry> sh_copy;
+  VmsoLog nat_log, rep_log;
+  std::vector<u64> nat_final; // value after the native run, by nat_log.q
+  std::vector<VmsoLog::Dev> nat_dev;
+  std::vector<std::string> nat_events; // chipset calls held back
+  std::map<int, Stat> stats;
+  u64 events = 0;
+};
+
+void CAlphaCPU::vmso_init() {
+  const char *p = getenv("ALPHABOX_VMSPAL_ORACLE");
+  if (!p || !*p || vmspal_lle_enabled)
+    return;
+  vmso = new VmsoState;
+  vmso->path = p;
+  printf("%%CPU-I-VMSORACLE: every native OpenVMS PALcode routine is compared "
+         "with the console's PALcode; report in %s\n",
+         p);
+}
+
+bool CAlphaCPU::vmso_idle() const { return vmso && vmso->phase == 0; }
+
+bool CAlphaCPU::vmso_call_native(int fn) const {
+  return vmso && vmso->phase == 0 && is_native_call(fn);
+}
+
+static void capture(CAlphaCPU::SCPU_state &s, CAlphaCPU::VmsoState::Regs &g,
+                    bool lock) {
+  g.pc = s.pc;
+  memcpy(g.r, s.r, sizeof(g.r));
+  g.cm = s.cm;
+  g.asn = s.asn;
+  g.asn0 = s.asn0;
+  g.asn1 = s.asn1;
+  g.fpen = s.fpen;
+  g.ppcen = s.ppcen;
+  g.cc_offset = s.cc_offset;
+  g.alt_cm = s.alt_cm;
+  g.exc_addr = s.exc_addr;
+  g.fault_va = s.fault_va;
+  g.va_form_va = s.va_form_va;
+  g.exc_sum = s.exc_sum;
+  g.mm_stat = s.mm_stat;
+  g.eien = s.eien;
+  g.slen = s.slen;
+  g.cren = s.cren;
+  g.pcen = s.pcen;
+  g.sien = s.sien;
+  g.asten = s.asten;
+  g.sir = s.sir;
+  g.astrr = s.astrr;
+  g.aster = s.aster;
+  g.bIntrFlag = s.bIntrFlag;
+  g.check_int = s.check_int;
+  g.lock = lock;
+  g.rem_ins_in_page = s.rem_ins_in_page;
+}
+
+static void restore(CAlphaCPU::SCPU_state &s,
+                    const CAlphaCPU::VmsoState::Regs &g) {
+  s.pc = g.pc;
+  memcpy(s.r, g.r, sizeof(g.r));
+  s.cm = g.cm;
+  s.asn = g.asn;
+  s.asn0 = g.asn0;
+  s.asn1 = g.asn1;
+  s.fpen = g.fpen;
+  s.ppcen = g.ppcen;
+  s.cc_offset = g.cc_offset;
+  s.alt_cm = g.alt_cm;
+  s.exc_addr = g.exc_addr;
+  s.fault_va = g.fault_va;
+  s.va_form_va = g.va_form_va;
+  s.exc_sum = g.exc_sum;
+  s.mm_stat = g.mm_stat;
+  s.eien = g.eien;
+  s.slen = g.slen;
+  s.cren = g.cren;
+  s.pcen = g.pcen;
+  s.sien = g.sien;
+  s.asten = g.asten;
+  s.sir = g.sir;
+  s.astrr = g.astrr;
+  s.aster = g.aster;
+  s.bIntrFlag = g.bIntrFlag;
+  s.check_int = g.check_int;
+  s.rem_ins_in_page = g.rem_ins_in_page;
+}
+
+bool CAlphaCPU::vmso_begin(int kind, int sub) {
+  if (!vmso || vmso->phase != 0)
+    return false;
+  VmsoState &o = *vmso;
+  capture(state, o.pre, cSystem->cpu_lock_held(state.iProcNum));
+  o.pre_llsc = m_llsc_clean;
+  o.kind = kind;
+  o.sub = sub;
+  o.pcbb_pre = sys_read(state.r[32 + 21] + 0x10, 64);
+  o.irq_seq0 = m_vmso_irq_seq.load();
+  o.started_pal = state.current_pc & 1;
+  o.tb_pre_valid = false;
+  o.nat_tb_changed = false;
+  o.sh_log.clear();
+  o.sh_all = false;
+  o.nat_log.clear();
+  o.rep_log.clear();
+  o.nat_events.clear();
+  o.phase = 1;
+  g_vmso_log = &o.nat_log;
+  g_vmso_mode = 1;
+  return true;
+}
+
+void CAlphaCPU::vmso_set_sub(int sub) {
+  if (vmso)
+    vmso->sub = sub;
+}
+
+void CAlphaCPU::vmso_held(const char *what) {
+  if (vmso && vmso->phase == 1)
+    vmso->nat_events.push_back(what);
+}
+
+bool CAlphaCPU::vmso_recording() const { return vmso && vmso->phase == 1; }
+
+void CAlphaCPU::vmso_tb_touch() {
+  if (!vmso || !vmso->phase || vmso->tb_pre_valid)
+    return;
+  VmsoState &o = *vmso;
+  memcpy(o.tb_pre, state.tb, sizeof(o.tb_pre));
+  memcpy(o.next_tb_pre, state.next_tb, sizeof(o.next_tb_pre));
+  memcpy(o.lft_pre, state.last_found_tb, sizeof(o.lft_pre));
+  o.tb_pre_valid = true;
+  if (o.phase == 1)
+    o.nat_tb_changed = true;
+}
+
+void CAlphaCPU::vmso_sh_note(int k) {
+  if (vmso && vmso->phase == 1 && !vmso->sh_all)
+    vmso->sh_log.push_back({k, m_tb_shadow[k]});
+}
+
+void CAlphaCPU::vmso_sh_note_all() {
+  if (vmso && vmso->phase == 1 && !vmso->sh_all) {
+    vmso->sh_copy.assign(m_tb_shadow, m_tb_shadow + kTbShadowEntries);
+    vmso->sh_all = true;
+  }
+}
+
+/**
+ * The native routine is done: keep its result and undo it. `target` is
+ * where the processor goes next with the native result; `res` is the
+ * native entry's return value (0: a TB fill, the instruction is retried).
+ **/
+void CAlphaCPU::vmso_end_native(u64 target, int res) {
+  VmsoState &o = *vmso;
+  g_vmso_log = nullptr;
+  g_vmso_mode = 0;
+  if (o.kind != VMSO_CALL && o.kind != VMSO_INT) {
+    // a TB miss or fault entry: a fill (retried), a dismissed fault (the
+    // next instruction), or an exception
+    const int s = res == 0 ? 0 : (target == state.current_pc + 4 ? 2 : 1);
+    o.sub = s | (o.started_pal ? 8 : 0);
+  }
+  capture(state, o.nat, cSystem->cpu_lock_held(state.iProcNum));
+  o.nat.pc = target;
+  o.nat_missed = int_deliverable() && !state.check_int;
+  o.nat_llsc = m_llsc_clean != 0;
+  // memory: what the native run left, then the values before it
+  o.nat_final.resize(o.nat_log.q.size());
+  for (size_t i = 0; i < o.nat_log.q.size(); i++)
+    o.nat_final[i] = *(const u64 *)(o.nat_log.base + o.nat_log.q[i].first);
+  for (size_t i = o.nat_log.q.size(); i-- > 0;)
+    *(u64 *)(o.nat_log.base + o.nat_log.q[i].first) = o.nat_log.q[i].second;
+  o.nat_dev = o.nat_log.dev;
+  // the translation buffer and its shadow
+  if (o.nat_tb_changed) {
+    memcpy(o.tb_nat, state.tb, sizeof(o.tb_nat));
+    memcpy(state.tb, o.tb_pre, sizeof(o.tb_pre));
+    memcpy(state.next_tb, o.next_tb_pre, sizeof(o.next_tb_pre));
+    memcpy(state.last_found_tb, o.lft_pre, sizeof(o.lft_pre));
+    tb_idx_rebuild();
+  }
+  if (o.sh_all)
+    memcpy(m_tb_shadow, o.sh_copy.data(), sizeof(STBEntry) * kTbShadowEntries);
+  else
+    for (size_t i = o.sh_log.size(); i-- > 0;)
+      m_tb_shadow[o.sh_log[i].first] = o.sh_log[i].second;
+  restore(state, o.pre);
+  cSystem->cpu_set_lock_held(state.iProcNum, o.pre.lock);
+  m_llsc_clean = o.pre_llsc;
+  flush_data_page_cache();
+  dpc_context_changed();
+  seq_remaining = 0;
+}
+
+void CAlphaCPU::vmso_start_replay() {
+  VmsoState &o = *vmso;
+  o.phase = 2;
+  o.icount = 0;
+  state.pal_vms = false; // the PALcode's own run: no native routine
+  g_vmso_log = &o.rep_log;
+  g_vmso_mode = 2;
+}
+
+static std::string hx(u64 v) {
+  char b[24];
+  snprintf(b, sizeof(b), "%" PRIx64, v);
+  return b;
+}
+
+static bool same_entry(const CAlphaCPU::STBEntry &a,
+                       const CAlphaCPU::STBEntry &b) {
+  if (a.valid != b.valid)
+    return false;
+  if (!a.valid)
+    return true;
+  return a.virt == b.virt && a.phys == b.phys && a.match_mask == b.match_mask &&
+         a.keep_mask == b.keep_mask && a.asm_bit == b.asm_bit &&
+         (a.asm_bit || a.asn == b.asn) &&
+         !memcmp(a.access, b.access, sizeof(a.access)) &&
+         !memcmp(a.fault, b.fault, sizeof(a.fault));
+}
+
+/// Compare two TBs as sets of valid entries: "" when they hold the same
+/// translations, else the first differing one.
+static std::string tb_entry(const CAlphaCPU::STBEntry &e) {
+  char buf[220];
+  snprintf(buf, sizeof(buf),
+           "va %" PRIx64 "/%" PRIx64 " pa %" PRIx64 " asn %d%s acc "
+           "r%d%d%d%d w%d%d%d%d f%d%d%d",
+           e.virt, e.match_mask, e.phys, e.asn, e.asm_bit ? " asm" : "",
+           !!e.access[0][0], !!e.access[0][1], !!e.access[0][2],
+           !!e.access[0][3], !!e.access[1][0], !!e.access[1][1],
+           !!e.access[1][2], !!e.access[1][3], !!e.fault[0], !!e.fault[1],
+           !!e.fault[2]);
+  return buf;
+}
+
+/// Compare two TBs as sets of valid entries: "" when they hold the same
+/// translations, else the first entry each side has alone.
+static std::string tb_diff(const CAlphaCPU::STBEntry *n,
+                           const CAlphaCPU::STBEntry *p) {
+  std::string r;
+  for (int pass = 0; pass < 2; pass++) {
+    const CAlphaCPU::STBEntry *a = pass ? p : n, *b = pass ? n : p;
+    for (int i = 0; i < TB_ENTRIES; i++) {
+      if (!a[i].valid)
+        continue;
+      bool found = false;
+      for (int j = 0; j < TB_ENTRIES && !found; j++)
+        found = same_entry(a[i], b[j]);
+      if (!found) {
+        r += std::string(pass ? " PALcode only: " : " native only: ") +
+             tb_entry(a[i]);
+        break;
+      }
+    }
+  }
+  return r;
+}
+
+void CAlphaCPU::vmso_boundary() {
+  VmsoState &o = *vmso;
+  o.icount++;
+  const bool timeout = o.icount > 400000;
+  if (!timeout && state.pc != o.nat.pc && (state.pc & 1))
+    return;
+  g_vmso_log = nullptr;
+  g_vmso_mode = 0;
+  o.phase = 0;
+  state.pal_vms = vmspal_pal_base && state.pal_base == vmspal_pal_base &&
+                  !vmspal_lle_enabled;
+  o.events++;
+
+  const int key = o.kind * 256 + o.sub;
+  Stat &st = o.stats[key];
+  st.n++;
+  // the boundary at the native result's PC is not one of the PALcode's
+  st.insns += o.icount - 1;
+  bool diff[NF] = {};
+  std::string why;
+  const auto &N = o.nat;
+  const u64 p21 = o.pre.r[32 + 21];
+  const u64 pcbb_pre = o.pcbb_pre;
+
+  if (timeout) {
+    diff[VF_TIMEOUT] = true;
+    why += " no return within 400000 instructions;";
+  }
+  if (state.pc != N.pc) {
+    diff[VF_PC] = true;
+    why += " pc N=" + hx(N.pc) + " P=" + hx(state.pc) + ";";
+  }
+  const u64 um = o.kind == VMSO_CALL ? unpredictable_regs(o.sub) : 0;
+  u64 rm = 0, urm = 0;
+  for (int i = 0; i < 31; i++)
+    if (state.r[i] != N.r[i]) {
+      if ((um >> i) & 1)
+        urm |= U64(1) << i;
+      else
+        rm |= U64(1) << i;
+    }
+  // RSCC's R0 is a clock reading; so is the SCC the timer interrupt keeps
+  bool time_r0 = false;
+  if (o.kind == VMSO_CALL && o.sub == 0x9d && (rm & 1)) {
+    const u64 d = state.r[0] - N.r[0];
+    if (d < U64(200000000)) {
+      rm &= ~U64(1);
+      time_r0 = true;
+    }
+  }
+  if (rm) {
+    diff[VF_R] = true;
+    st.regmask |= rm;
+    for (int i = 0; i < 31; i++)
+      if ((rm >> i) & 1)
+        why += " r" + std::to_string(i) + " N=" + hx(N.r[i]) +
+               " P=" + hx(state.r[i]) + ";";
+  }
+  if (urm) {
+    st.umask |= urm;
+  }
+  if (state.r[32 + 22] != N.r[32 + 22]) {
+    diff[VF_PS] = true;
+    why += " ps(p22) N=" + hx(N.r[32 + 22]) + " P=" + hx(state.r[32 + 22]) +
+           ";";
+  }
+  if (state.r[32 + 21] != N.r[32 + 21]) {
+    diff[VF_P21] = true;
+    why += " p21 N=" + hx(N.r[32 + 21]) + " P=" + hx(state.r[32 + 21]) + ";";
+  }
+  if (state.cm != N.cm) {
+    diff[VF_CM] = true;
+    why += " cm N=" + std::to_string(N.cm) + " P=" + std::to_string(state.cm) +
+           ";";
+  }
+  if (state.asn != N.asn || state.asn0 != N.asn0 || state.asn1 != N.asn1) {
+    diff[VF_ASN] = true;
+    why += " asn N=" + std::to_string(N.asn) + "/" + std::to_string(N.asn0) +
+           "/" + std::to_string(N.asn1) + " P=" + std::to_string(state.asn) +
+           "/" + std::to_string(state.asn0) + "/" +
+           std::to_string(state.asn1) + ";";
+  }
+  if (state.fpen != N.fpen || state.ppcen != N.ppcen) {
+    diff[VF_FEN] = true;
+    why += " fen/ppce N=" + std::to_string(N.fpen) + std::to_string(N.ppcen) +
+           " P=" + std::to_string(state.fpen) + std::to_string(state.ppcen) +
+           ";";
+  }
+  bool time_cc = false;
+  if (state.cc_offset != N.cc_offset) {
+    const u32 d = (u32)(N.cc_offset - state.cc_offset);
+    if (d < 200000000u)
+      time_cc = true;
+    else {
+      diff[VF_CCOFF] = true;
+      why += " cc_offset N=" + hx(N.cc_offset) + " P=" + hx(state.cc_offset) +
+             ";";
+    }
+  }
+  if (state.eien != N.eien || state.slen != N.slen || state.cren != N.cren ||
+      state.pcen != N.pcen || state.sien != N.sien || state.asten != N.asten) {
+    diff[VF_IER] = true;
+    char b[160];
+    snprintf(b, sizeof(b),
+             " ier N=ei%x sl%x cr%x pc%x si%x ast%x P=ei%x sl%x cr%x pc%x si%x "
+             "ast%x;",
+             N.eien, N.slen, N.cren, N.pcen, N.sien, N.asten, state.eien,
+             state.slen, state.cren, state.pcen, state.sien, state.asten);
+    why += b;
+  }
+  if (state.aster != N.aster || state.astrr != N.astrr) {
+    diff[VF_AST] = true;
+    why += " aster/astrr N=" + hx(N.aster) + "/" + hx(N.astrr) +
+           " P=" + hx(state.aster) + "/" + hx(state.astrr) + ";";
+  }
+  if (state.sir != N.sir) {
+    diff[VF_SIR] = true;
+    why += " sir N=" + hx(N.sir) + " P=" + hx(state.sir) + ";";
+  }
+  // What a STx_C would do now: the lock flag, and no memory operation
+  // since the LDx_L (HRM D.19, which the PALcode's own LDQ/STQ obey and
+  // the native routines' accesses do not). The flag alone is counted apart.
+  const bool lock_p = cSystem->cpu_lock_held(state.iProcNum);
+  const bool stc_n = N.lock && o.nat_llsc, stc_p = lock_p && m_llsc_clean;
+  if (stc_n != stc_p) {
+    diff[VF_LOCK] = true;
+    why += std::string(" STx_C would ") + (stc_n ? "succeed" : "fail") +
+           " after N, " + (stc_p ? "succeed" : "fail") + " after P (flag N=" +
+           (N.lock ? "1" : "0") + " P=" + (lock_p ? "1" : "0") + ");";
+  } else if (lock_p != N.lock)
+    st.lockflag_only++;
+  const bool p_missed = int_deliverable() && !state.check_int;
+  if (o.nat_missed && !p_missed) {
+    diff[VF_SIG] = true;
+    why += " native leaves a deliverable interrupt unsignalled;";
+  }
+  // the native result continues inside the PALcode (a fault in PALmode
+  // handed to the PALcode's own fault routine, at 0xd980): the PALshadow
+  // registers are its arguments there. (After a fill they are what the miss
+  // handler left, which the interrupted PALcode cannot depend on: the
+  // hardware's handler clobbers them too.)
+  if ((N.pc & 1) && o.kind != VMSO_CALL && o.kind != VMSO_INT &&
+      (o.sub & 3) == 1 && state.pc == N.pc) {
+    static const int pr[] = {4, 5, 6, 7, 20, 23};
+    for (int k : pr)
+      if (state.r[32 + k] != N.r[32 + k]) {
+        diff[VF_PREG] = true;
+        why += " p" + std::to_string(k) + " N=" + hx(N.r[32 + k]) +
+               " P=" + hx(state.r[32 + k]) + ";";
+      }
+    if (state.r[26] != N.r[26]) {
+      diff[VF_PREG] = true;
+      why += " r26 N=" + hx(N.r[26]) + " P=" + hx(state.r[26]) + ";";
+    }
+  }
+  // translation buffers
+  if (o.tb_pre_valid || o.nat_tb_changed) {
+    for (int t = 0; t < 2; t++) {
+      const STBEntry *n = o.nat_tb_changed ? o.tb_nat[t] : o.tb_pre[t];
+      std::string d = tb_diff(n, state.tb[t]);
+      if (!d.empty()) {
+        diff[t == TB_INDEX_DATA ? VF_TBD : VF_TBI] = true;
+        why += std::string(t == TB_INDEX_DATA ? " dtb " : " itb ") + d + ";";
+      }
+    }
+  }
+  // memory: every quadword either run wrote
+  {
+    std::vector<std::pair<u64, std::pair<u64, u64>>> m; // q -> (N, P)
+    const char *base = o.nat_log.base ? o.nat_log.base : o.rep_log.base;
+    for (size_t i = 0; i < o.nat_log.q.size(); i++) {
+      const u64 q = o.nat_log.q[i].first;
+      m.push_back({q, {o.nat_final[i], *(const u64 *)(base + q)}});
+    }
+    for (const auto &e : o.rep_log.q) {
+      bool in = false;
+      for (const auto &x : o.nat_log.q)
+        in |= x.first == e.first;
+      if (!in)
+        m.push_back({e.first, {e.second, *(const u64 *)(base + e.first)}});
+    }
+    for (const auto &e : m) {
+      const u64 q = e.first, nv = e.second.first, pv = e.second.second;
+      if (nv == pv)
+        continue;
+      const bool scratch = q >= p21 && q < p21 + 0x200;
+      // the clock: the SCC kept at scratch+0xa0, a process's charged
+      // cycles at PCB+0x40
+      const bool clock = (scratch && q - p21 == 0xa0) ||
+                         ((o.kind == VMSO_CALL && o.sub == 0x05) &&
+                          (q & 0x7f) == 0x40);
+      if (clock && (u64)(pv - nv) < U64(200000000))
+        continue;
+      if (clock && (u32)(pv - nv) < 200000000u && (pv >> 32) == (nv >> 32))
+        continue;
+      diff[scratch ? VF_MEMS : VF_MEMG] = true;
+      if (scratch)
+        st.scratch[q - p21]++;
+      std::string where = scratch ? "scratch+" + hx(q - p21)
+                          : (q >= pcbb_pre && q < pcbb_pre + 0x80)
+                              ? "pcb+" + hx(q - pcbb_pre)
+                              : "pa " + hx(q);
+      why += " mem " + where + " N=" + hx(nv) + " P=" + hx(pv) + ";";
+    }
+  }
+
+  const bool race = m_vmso_irq_seq.load() != o.irq_seq0;
+  bool dmiss = false;
+  for (auto &e : o.nat_events)
+    dmiss |= e == "double-miss";
+  bool any = false;
+  for (int f = 0; f < NF; f++)
+    if (diff[f]) {
+      any = true;
+      st.field[f]++;
+    }
+  if (dmiss)
+    st.dmiss++;
+  if (!any) {
+    st.same++;
+    if (time_r0 || time_cc)
+      st.time_only++;
+    if (urm)
+      st.unpred_only++;
+  } else {
+    // keep a few examples per field
+    int f0 = 0;
+    while (!diff[f0])
+      f0++;
+    // the scratch-only differences: fewer examples
+    bool only_scratch = true;
+    for (int f = 0; f < NF; f++)
+      if (diff[f] && f != VF_MEMS)
+        only_scratch = false;
+    if (race)
+      st.race++;
+    if (dmiss)
+      st.dmiss_diff++;
+    if (st.nex[f0] < (only_scratch ? 2 : 8)) {
+      st.nex[f0]++;
+      char hdr[400];
+      snprintf(hdr, sizeof(hdr),
+               "  #%" PRIu64 " pc %" PRIx64 " ps %" PRIx64 " cm %d r16 %" PRIx64
+               " r17 %" PRIx64 " r30 %" PRIx64 " exc_addr %" PRIx64
+               " va %" PRIx64 " mm_stat %" PRIx64 ":",
+               o.events, o.pre.pc, o.pre.r[32 + 22], o.pre.cm, o.pre.r[16],
+               o.pre.r[17], o.pre.r[30], o.pre.exc_addr, o.pre.fault_va,
+               o.pre.mm_stat);
+      std::string ex = hdr + std::string(race ? " [interrupt arrived]" : "") +
+                       (dmiss ? " [double miss]" : "") + why;
+      if (!o.nat_events.empty() || !o.nat_dev.empty() ||
+          !o.rep_log.dev.empty()) {
+        ex += "\n      native io:";
+        for (auto &e : o.nat_events)
+          ex += " [" + e + "]";
+        for (auto &d : o.nat_dev)
+          ex += std::string(d.write ? " W" : " R") + (d.held ? "(held)" : "") +
+                " " + hx(d.addr) + "=" + hx(d.val);
+        ex += "\n      PALcode io:";
+        for (auto &d : o.rep_log.dev)
+          ex += std::string(d.write ? " W" : " R") + " " + hx(d.addr) + "=" +
+                hx(d.val);
+      }
+      st.ex.push_back(ex);
+    }
+  }
+  if (o.events % 20000 == 0)
+    vmso_report(false);
+}
+
+void CAlphaCPU::vmso_report(bool final) {
+  if (!vmso)
+    return;
+  VmsoState &o = *vmso;
+  FILE *f = fopen(o.path, "w");
+  if (!f)
+    return;
+  fprintf(f, "vmspal oracle: %" PRIu64 " compared events%s\n", o.events,
+          final ? " (final)" : "");
+  u64 pal = 0;
+  for (auto &kv : o.stats)
+    pal += kv.second.insns;
+  const u64 all = state.instruction_count;
+  fprintf(f,
+          "instructions: %" PRIu64 " executed, %" PRIu64
+          " of them the PALcode doing what a native routine replaces "
+          "(%.1f%%)\n",
+          all, pal, all ? 100.0 * (double)pal / (double)all : 0.0);
+  fprintf(f, "%-30s %10s %10s %10s %8s  %s\n", "routine", "compared", "same",
+          "differ", "PAL ins", "fields that differed (count)");
+  for (auto &kv : o.stats) {
+    const int kind = kv.first >> 8, sub = kv.first & 0xff;
+    const Stat &st = kv.second;
+    char name[64];
+    switch (kind) {
+    case VMSO_CALL:
+      snprintf(name, sizeof(name), "CALL_PAL %02x %s", sub, callname(sub));
+      break;
+    case VMSO_INT:
+      snprintf(name, sizeof(name), "interrupt: %s", intname(sub));
+      break;
+    default: {
+      static const char *kn[] = {"", "", "DTB miss", "ITB miss", "IACV",
+                                 "DFAULT"};
+      static const char *sn[] = {"fill", "exception", "dismissed"};
+      snprintf(name, sizeof(name), "%s %s%s", kn[kind], sn[sub & 3],
+               (sub & 8) ? " (PALmode)" : "");
+    }
+    }
+    std::string fl;
+    for (int fi = 0; fi < NF; fi++)
+      if (st.field[fi])
+        fl += std::string(fname[fi]) + "(" + std::to_string(st.field[fi]) +
+              ") ";
+    if (st.regmask) {
+      fl += "regs:";
+      for (int i = 0; i < 31; i++)
+        if ((st.regmask >> i) & 1)
+          fl += " r" + std::to_string(i);
+      fl += " ";
+    }
+    if (st.time_only)
+      fl += "[clock readings differ " + std::to_string(st.time_only) + "] ";
+    if (st.race)
+      fl += "[interrupt arrived in " + std::to_string(st.race) + "] ";
+    if (st.lockflag_only)
+      fl += "[lock flag only, STx_C fails after both: " +
+            std::to_string(st.lockflag_only) + "] ";
+    if (st.dmiss)
+      fl += "[double miss in " + std::to_string(st.dmiss) + ", " +
+            std::to_string(st.dmiss_diff) + " differing] ";
+    if (!st.scratch.empty()) {
+      fl += "[scratch:";
+      for (auto &s : st.scratch)
+        fl += " +" + hx(s.first) + "(" + std::to_string(s.second) + ")";
+      fl += "] ";
+    }
+    if (st.umask) {
+      fl += "[UNPREDICTABLE regs differ:";
+      for (int i = 0; i < 31; i++)
+        if ((st.umask >> i) & 1)
+          fl += " r" + std::to_string(i);
+      fl += "] ";
+    }
+    fprintf(f, "%-30s %10" PRIu64 " %10" PRIu64 " %10" PRIu64 " %8.1f  %s\n",
+            name, st.n, st.same, st.n - st.same,
+            st.n ? (double)st.insns / (double)st.n : 0.0, fl.c_str());
+  }
+  fprintf(f, "\nexamples (state before the routine; N = native, P = "
+             "PALcode):\n");
+  for (auto &kv : o.stats) {
+    if (kv.second.ex.empty())
+      continue;
+    const int kind = kv.first >> 8, sub = kv.first & 0xff;
+    fprintf(f, "kind %d sub %02x%s%s:\n", kind, sub,
+            kind == VMSO_CALL ? " " : "",
+            kind == VMSO_CALL ? callname(sub)
+                              : (kind == VMSO_INT ? intname(sub) : ""));
+    for (auto &e : kv.second.ex)
+      fprintf(f, "%s\n", e.c_str());
+  }
+  fclose(f);
+}
diff --color -ruN pristine/src/cpu/VmspalOracle.hpp osrc/src/cpu/VmspalOracle.hpp
--- pristine/src/cpu/VmspalOracle.hpp	1970-01-01 01:00:00
+++ osrc/src/cpu/VmspalOracle.hpp	2026-10-22 22:06:24
@@ -0,0 +1,71 @@
+/* Alphabox Alpha Emulator
+ * The vmspal differential oracle (test/vms/vmspal_oracle.sh): applied as a
+ * patch to a copy of the tree, never part of a normal build.
+ *
+ * Every native OpenVMS PALcode routine (cpu/AlphaCPU_vmspal.cpp) runs first
+ * with its effects recorded: its stores to memory, its translation-buffer
+ * changes, its device accesses (the ones a second run would repeat are
+ * held back: chipset CSR writes, the interval-timer and IPI acknowledges,
+ * the PIC's acknowledge cycle, which is peeked instead). Its result is kept
+ * and undone, and the console's own PALcode then does the same work from
+ * the same state. When the PALcode returns (the first instruction boundary
+ * at the native routine's result PC, or the first one in native mode) the
+ * two results are compared. The guest goes on with the PALcode's.
+ */
+#ifndef INCLUDED_VMSPALORACLE_H
+#define INCLUDED_VMSPALORACLE_H
+
+#include "datatypes.hpp"
+#include <string>
+#include <vector>
+
+/// Stores and device accesses made while a log is active on this thread.
+struct VmsoLog {
+  const char *base = nullptr;         // DRAM, host side
+  std::vector<std::pair<u64, u64>> q; // quadword address, value before
+  struct Dev {
+    u64 addr;
+    u64 val;
+    int size;
+    bool write;
+    bool held; // a write the recording run did not perform
+  };
+  std::vector<Dev> dev;
+  void clear() {
+    q.clear();
+    dev.clear();
+  }
+  void note(const char *b, u64 qa) {
+    base = b;
+    for (const auto &e : q)
+      if (e.first == qa)
+        return;
+    q.push_back({qa, *(const u64 *)(b + qa)});
+  }
+};
+
+/// What was compared: a CALL_PAL routine (sub = its function), the
+/// interrupt entries, the TB-miss and fault entries.
+enum { VMSO_CALL = 0, VMSO_INT, VMSO_DTBM, VMSO_ITBM, VMSO_IACV, VMSO_DFAULT };
+/// The interrupt entry that delivered (or none).
+enum {
+  VMSO_I_IPI,
+  VMSO_I_TIMER,
+  VMSO_I_PCI,
+  VMSO_I_PIC,
+  VMSO_I_PIC_DISMISSED,
+  VMSO_I_EXT_DISMISSED,
+  VMSO_I_SW,
+  VMSO_I_AST,
+  VMSO_I_NONE
+};
+
+extern thread_local VmsoLog *g_vmso_log;
+/// 0 off, 1 the native routine is being recorded, 2 the PALcode replays.
+extern thread_local int g_vmso_mode;
+
+void vmso_note_dram(const char *base, u64 phys, int dsize);
+/// A device access; returns true when the write must not be performed.
+bool vmso_note_dev(u64 addr, int dsize, u64 val, bool write);
+
+#endif
