+/* Alphabox Alpha Emulator
+ * The vmspal differential oracle: see VmspalOracle.hpp and
+ * test/vms/vmspal_oracle.sh. Not part of a normal build.
+ */
+#include "AlphaCPU.hpp"
+#include "StdAfx.hpp"
+#include "System.hpp"
+#include "Tsunami.hpp"
+#include "VmspalOracle.hpp"
+
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+
+thread_local VmsoLog *g_vmso_log = nullptr;
+thread_local int g_vmso_mode = 0;
+
+void vmso_note_dram(const char *base, u64 phys, int dsize) {
+  VmsoLog *L = g_vmso_log;
+  if (!L)
+    return;
+  const int bytes = dsize >= 8 ? dsize / 8 : 1;
+  const u64 q0 = phys & ~U64(7);
+  const u64 q1 = (phys + bytes - 1) & ~U64(7);
+  for (u64 q = q0; q <= q1; q += 8)
+    L->note(base, q);
+}
+
+bool vmso_note_dev(u64 addr, int dsize, u64 val, bool write) {
+  VmsoLog *L = g_vmso_log;
+  if (!L)
+    return false;
+  // The Tsunami's CSRs (Cchip, Dchip, Pchips at 801.A000.0000 to
+  // 801.BFFF.FFFF) acknowledge, mask and send interrupts: the recording run
+  // leaves them to the PALcode's run.
+  const bool csr = addr >= U64(0x801a0000000) && addr < U64(0x801c0000000);
+  const bool held = write && g_vmso_mode == 1 && csr;
+  L->dev.push_back({addr, val, dsize, write, held});
+  return held;
+}
