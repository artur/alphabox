+/// Registers the ARM leaves UNPREDICTABLE after the routine (13.1: R1, R16
+/// and R17 after any MxPR, and R0 after an MTPR that returns nothing).
+u64 unpredictable_regs(int fn) {
+  const u64 r = (U64(1) << 1) | (U64(1) << 16) | (U64(1) << 17);
+  switch (fn) {
+  case 0x06: case 0x0b: case 0x0e: case 0x10: case 0x12: case 0x13:
+  case 0x15: case 0x16: case 0x19: case 0x1a: case 0x1e: case 0x20:
+  case 0x22: case 0x26: case 0x27: case 0x29: case 0x3f: // MFPR
+  case 0x07: case 0x08: case 0x0f:                       // MTPR with R0
+    return r;
+  case 0x0c: case 0x11: case 0x14: case 0x17: case 0x18: case 0x1b:
+  case 0x1c: case 0x1d: case 0x1f: case 0x21: case 0x23: case 0x24:
+  case 0x25: case 0x2e: // MTPR without a result
+    return r | 1;
+  }
+  return 0;
+}
